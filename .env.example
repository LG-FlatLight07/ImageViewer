# Copy this file to `.env` (same folder) and fill in your own Supabase
# project's values. `.env` is gitignored — never commit real values.
#
# Both variables MUST be prefixed with EXPO_PUBLIC_ so Expo inlines them into
# the app bundle at build time. They are the "anon / publishable" key only —
# safe to ship inside the app, never put the service_role/secret key here.
#
# Find these in the Supabase dashboard: Project Settings > Data API / API Keys.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
